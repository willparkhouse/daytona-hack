# Daytona sandbox API key — app.daytona.io → Billing (redeem coupon) → API Keys
DAYTONA_API_KEY=

# OpenAI API key for the in-sandbox agents (the event's Codex API credits).
# Redeem at platform.openai.com; the in-sandbox agent (agent/agent.py) calls it.
OPENAI_API_KEY=

# Model the in-sandbox agents use. gpt-5-codex is not on every account; gpt-5 works.
OPENAI_MODEL=gpt-5
